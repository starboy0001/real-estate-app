* {
  box-sizing: border-box;
}

:root {
  font-family: 'Inter', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #0f172a;
  background: #f3f6fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  margin: 0;
  background: linear-gradient(135deg, #eef3ff 0%, #f8fafc 100%);
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

.auth-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: radial-gradient(circle at top, rgba(59, 130, 246, 0.15), transparent 35%), linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
}

.auth-card {
  width: min(100%, 430px);
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
  border-radius: 24px;
  padding: 28px;
  backdrop-filter: blur(8px);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
}

.brand-icon {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-size: 1.4rem;
  font-weight: 800;
  background: linear-gradient(135deg, #0f172a, #2563eb);
  color: white;
}

.eyebrow {
  margin: 0;
  font-size: 0.72rem;
  color: #64748b;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1, h2, h3, p {
  margin-top: 0;
}

.auth-card h1 {
  margin: 0;
  font-size: 2rem;
}

.auth-card h2 {
  margin: 0 0 8px;
  font-size: 1.8rem;
}

.subtitle {
  margin-bottom: 24px;
  color: #475569;
}

.login-form {
  display: grid;
  gap: 18px;
}

.login-form label {
  display: grid;
  gap: 8px;
  font-weight: 600;
  color: #334155;
}

.login-form input,
.filters input,
.filters select {
  width: 100%;
  border: 1px solid #dbe3f0;
  background: #f8fafc;
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
  color: #0f172a;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.login-form input:focus,
.filters input:focus,
.filters select:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
}

.primary-btn,
.secondary-btn,
.view-btn {
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn:hover,
.secondary-btn:hover,
.view-btn:hover {
  transform: translateY(-1px);
}

.primary-btn {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: white;
}

.secondary-btn {
  background: #e2e8f0;
  color: #0f172a;
}

.error-box {
  background: #fee2e2;
  color: #b91c1c;
  border: 1px solid #fecaca;
  padding: 10px 12px;
  border-radius: 10px;
  font-size: 0.93rem;
}

.demo-box {
  display: flex;
  flex-direction: column;
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid #e2e8f0;
  color: #475569;
  gap: 4px;
}

.app-shell {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 20px;
  padding: 18px 22px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
}

.topbar h2 {
  margin: 0;
  font-size: 1.5rem;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 24px;
  margin-top: 28px;
  padding: 32px 18px 12px;
}

.hero h1 {
  margin: 0;
  font-size: clamp(2.1rem, 3vw, 3.6rem);
  line-height: 1.1;
  max-width: 620px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 12px;
  min-width: min(100%, 420px);
}

.stat-card {
  background: linear-gradient(135deg, #ffffff, #eef4ff);
  border: 1px solid #dfeafc;
  border-radius: 18px;
  padding: 18px 16px;
  display: grid;
  gap: 8px;
}

.stat-card span {
  color: #64748b;
  font-size: 0.8rem;
}

.stat-card strong {
  font-size: 1.7rem;
  color: #0f172a;
}

.filters {
  display: grid;
  grid-template-columns: 1.5fr 0.75fr;
  gap: 14px;
  margin-top: 22px;
  padding: 0 18px;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  gap: 24px;
  margin-top: 26px;
}

.project-card {
  overflow: hidden;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
}

.project-card img {
  display: block;
  width: 100%;
  height: 220px;
  object-fit: cover;
}

.project-body {
  padding: 18px;
}

.project-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.project-header h3 {
  margin: 0;
  font-size: 1.2rem;
}

.project-header p {
  margin: 6px 0 0;
  color: #64748b;
  font-size: 0.93rem;
}

.badge {
  background: #dcfce7;
  color: #166534;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.75rem;
  font-weight: 700;
  white-space: nowrap;
}

.project-price {
  margin-top: 18px;
  font-size: 1.7rem;
  font-weight: 800;
  color: #0f172a;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 16px;
  color: #475569;
  font-size: 0.85rem;
}

.project-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
}

.type-tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  background: #eff6ff;
  color: #1d4ed8;
  padding: 8px 12px;
  font-size: 0.78rem;
  font-weight: 700;
}

.view-btn {
  background: #0f172a;
  color: white;
}

@media (max-width: 768px) {
  .hero {
    flex-direction: column;
    align-items: flex-start;
  }

  .stats-grid {
    width: 100%;
  }

  .filters {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
